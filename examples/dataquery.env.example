# Tau data-query 上线部署模板
#
# 用法：
#   1. 复制为 .env（或直接作为部署环境变量注入）：
#        cp examples/dataquery.env.example .env
#   2. 按实际环境填写，删除不用的行即可；留空行表示使用内置默认值。
#   3. 环境变量优先级最高（env > dataquery.json > 内置默认值）。
#
# 敏感信息（密码 / token）：
#   推荐放在 ~/.tau/credentials.json（见文件末尾），生产环境也可用
#   密钥管理系统注入，不放进仓库。

# ---------------------------------------------------------------------------
# DWS / openGauss 连接
# ---------------------------------------------------------------------------

# 数据库主机（默认 localhost）
TAU_DWS_HOST=localhost

# 数据库端口（默认 35432）
TAU_DWS_PORT=35432

# 数据库名（默认 exchange_service）
TAU_DWS_DATABASE=exchange_service

# 只读查询账号（必填）
TAU_DWS_USER=reader

# SSL 模式：disable / prefer / require / verify-ca / verify-full（默认 prefer）
# TAU_DWS_SSL_MODE=prefer

# 单条查询超时秒数（默认 180）
# TAU_DWS_TIMEOUT_SECONDS=180

# 单次查询最大返回行数（默认 1000）
# TAU_DWS_MAX_ROWS=1000

# 单次查询结果总大小上限，字节（默认 1048576 = 1MB）
# TAU_DWS_MAX_RESULT_BYTES=1048576

# 单单元格最大字节数（默认 65536 = 64KB）
# TAU_DWS_MAX_CELL_BYTES=65536

# 连接建立超时秒数（默认 10）
# TAU_DWS_CONNECT_TIMEOUT=10

# 连接测试用的探针 SQL（默认 SELECT 1）
# TAU_DWS_PROBE_QUERY=SELECT 1

# 允许查询的 schema 或 schema.table，逗号分隔（默认 fail-closed：未配置时
# 只允许 information_schema / pg_catalog，业务表全部拒绝）
# 例：TAU_DWS_ALLOWED_OBJECTS=exchange_service,exchange_service.orders

# ---------------------------------------------------------------------------
# SAG 规划模式（三选一；必须显式选择）
# ---------------------------------------------------------------------------

# unconfigured：不注册数据查询工具；legacy：MCP 检索；agent：SAG Agent 规划
TAU_SAG_PLANNING_MODE=legacy

# SAG 访问 token（legacy / agent 均必填；也可放 credentials.json）
TAU_SAG_TOKEN=

# ---------------------------------------------------------------------------
# legacy 模式：SAG 知识库 MCP
# ---------------------------------------------------------------------------

# 完整 MCP URL；legacy 模式未填写时使用 http://localhost:8100/mcp/
TAU_SAG_ENDPOINT=http://localhost:8100/mcp/

# 知识来源 source_id（默认 19d09d3733c34716bcdf906738d10b03）
# TAU_SAG_SOURCE_ID=19d09d3733c34716bcdf906738d10b03

# SAG 工具名与参数名（默认与 SAG 契约一致，一般不用改）
# TAU_SAG_SEARCH_TOOL=search
# TAU_SAG_READ_TOOL=get_chunk
# TAU_SAG_ARG_QUERY=query
# TAU_SAG_ARG_SOURCE=source_id
# TAU_SAG_ARG_DOCUMENT=chunk_id

# MCP 协议版本（默认 2025-03-26）
# TAU_SAG_PROTOCOL_VERSION=2025-03-26

# 单次 RPC 调用超时秒数（默认 60）
# TAU_SAG_RPC_TIMEOUT_SECONDS=60

# 连接测试用的探针查询（默认 __probe__）
# TAU_SAG_PROBE_QUERY=__probe__

# 搜索结果摘要最大字节数（默认 8192 = 8KB）
# TAU_SAG_SEARCH_SUMMARY_MAX_BYTES=8192

# ---------------------------------------------------------------------------
# agent 模式：SAG OpenAI-compatible Agent chat
# ---------------------------------------------------------------------------

# 必须是 origin（仅 scheme + host + 可选 port），不要包含 /api/v1 路径。
# Tau 会拼接 /api/v1/openai/{agent_id}/chat/completions。
# TAU_SAG_AGENT_ORIGIN=http://localhost:8100

# 可信部署配置，不能由模型工具参数覆盖；仅允许字母、数字、_、-。
# TAU_SAG_AGENT_ID=your-agent-id

# Agent HTTP 超时与响应预算（均不可超过内置硬上限）
# TAU_SAG_AGENT_TIMEOUT_SECONDS=60
# TAU_SAG_AGENT_ANSWER_MAX_BYTES=65536
# TAU_SAG_CITATION_LIMIT=5
# TAU_SAG_CITATION_SNIPPET_MAX_BYTES=8192
# TAU_SAG_PLANNER_TRANSCRIPT_MAX_BYTES=262144

# Agent 模式可选保留 TAU_SAG_ENDPOINT，用于展开含 chunk_id 的 citation；
# 不配置 MCP 时 citation 摘要仍可见，但 data_knowledge_read 干净失败。

# ---------------------------------------------------------------------------
# 行为开关
# ---------------------------------------------------------------------------

# 设为 1 时 data_query_execute 不再弹窗确认（只建议在内网可信环境使用）
# TAU_DATA_AUTO_APPROVE_EXECUTE=0

# ---------------------------------------------------------------------------
# 敏感信息（二选一：环境变量 或 credentials.json）
# ---------------------------------------------------------------------------
# 把 examples/credentials.json.example 复制为 ~/.tau/credentials.json 并填写：
#
#   {
#     "dataquery.dws.password": "数据库只读账号密码",
#     "dataquery.sag.token": "SAG token"
#   }
#
# 若使用上面的 TAU_SAG_TOKEN 环境变量，credentials.json 中可省略 sag.token。

# ---------------------------------------------------------------------------
# 备选：用户级配置文件 ~/.tau/dataquery.json
# ---------------------------------------------------------------------------
# 不想用环境变量时，可直接把 examples/dataquery.json.example 复制为
# ~/.tau/dataquery.json 并按需修改。优先级：环境变量 > dataquery.json > 默认值。
# 注意：密码/token 不要写进 dataquery.json，只放 credentials.json。
